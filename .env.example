# Secrets read by docker-compose.yml via ${VAR:-} substitution.
# Copy to .env at the project root and fill in.

# Stripe
STRIPE_SECRET_KEY=sk_test_...
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=eur

# PocketBase superuser credentials (used by server-side basket/checkout/webhook APIs)
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=changeme

# Booking emails via Brevo's SMTP relay (Brevo → SMTP & API → SMTP).
# Leave SMTP_HOST empty in development: emails are then written to the
# app logs instead of being sent.
# Brevo: smtp-relay.brevo.com
SMTP_HOST=
# 587 (STARTTLS); use 2525 if your network blocks 587, or 465 for implicit TLS
SMTP_PORT=587
# The SMTP login Brevo shows (xxxx@smtp-brevo.com), NOT your account email
SMTP_USER=
# The SMTP key generated in Brevo (not your account password)
SMTP_PASS=
# Must be a sender on a domain authenticated in Brevo
EMAIL_FROM=bookings@example.com
EMAIL_FROM_NAME=Demo Studio
# Timezone used for booking times in emails (IANA name)
SITE_TIMEZONE=Europe/Oslo

# Caddy scheme for the reverse proxy on port 8080.
#   http  (default) — plain HTTP; matches the ORIGIN vars in docker-compose.yml
#   https           — HTTPS on :8080 (self-signed unless you add a cert issuer;
#                    also update ORIGIN/PUBLIC_* URLs to https://...)
CADDY_SCHEME=http
