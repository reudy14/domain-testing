# Secrets read by docker-compose.yml via ${VAR:-} substitution.
# Copy to .env at the project root and fill in.

# Stripe. The secret key and webhook secret go to PocketBase only (the shop
# API in pocketbase/pb_hooks); the public app gets just the publishable key.
STRIPE_SECRET_KEY=sk_test_...
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Shop currency (ISO 4217, e.g. eur, nok): what Stripe charges in and what
# every price on the site, in the admin and in booking emails is shown in.
# Item prices are entered in this currency.
STRIPE_CURRENCY=eur

# Shared by PocketBase and the public app so the public app can record
# booking-email status on orders (its only write). Generate a long random
# value, e.g.: openssl rand -hex 32
INTERNAL_API_SECRET=

# Booking emails via Brevo's SMTP relay (Brevo → SMTP & API → SMTP).
# Leave SMTP_HOST empty in development: emails are then written to the
# app logs instead of being sent.
# Brevo: smtp-relay.brevo.com
SMTP_HOST=
# 587 (STARTTLS); use 2525 if your network blocks 587, or 465 for implicit TLS
SMTP_PORT=587
# The SMTP login Brevo shows (xxxx@smtp-brevo.com), NOT your account email
SMTP_USER=
# The SMTP key generated in Brevo (not your account password)
SMTP_PASS=
# Must be a sender on a domain authenticated in Brevo
EMAIL_FROM=bookings@example.com
EMAIL_FROM_NAME=Demo Studio
# Timezone used for booking times in emails (IANA name)
SITE_TIMEZONE=Europe/Oslo

# Public URLs the browser uses: <URL_SCHEME>://admin.<DOMAIN><URL_PORT>.
# They must match the address bar exactly (SvelteKit's form CSRF check).
# Local default: http + :8080. Behind a reverse proxy / TLS on 443, e.g.:
#   URL_SCHEME=https
#   URL_PORT=
# (empty URL_PORT = no port in the URL; leave the line out to get :8080)
DOMAIN=localhost
URL_SCHEME=http
URL_PORT=:8080

# Caddy scheme for the reverse proxy on port 8080.
#   http  (default) — plain HTTP; matches the ORIGIN vars in docker-compose.yml
#   https           — HTTPS on :8080 (self-signed unless you add a cert issuer;
#                    also update ORIGIN/PUBLIC_* URLs to https://...)
CADDY_SCHEME=http
