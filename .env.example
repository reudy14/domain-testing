# Secrets read by docker-compose.yml via ${VAR:-} substitution.
# Copy to .env at the project root and fill in.

# Stripe
STRIPE_SECRET_KEY=sk_test_...
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=eur

# PocketBase superuser credentials (used by server-side basket/checkout/webhook APIs)
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=changeme

# Caddy scheme for the reverse proxy on port 8080.
#   http  (default) — plain HTTP; matches the ORIGIN vars in docker-compose.yml
#   https           — HTTPS on :8080 (self-signed unless you add a cert issuer;
#                    also update ORIGIN/PUBLIC_* URLs to https://...)
CADDY_SCHEME=http
